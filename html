<meta name="theme-color" content="#0c0e13">
<style>
:root{
  --bg:#0c0e13; --panel:#151821; --panel2:#1c202b; --border:#272c38;
  --text:#eef0f4; --muted:#8b93a5; --accent:#ff5b2e; --accent2:#ffb020;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
  box-sizing:border-box;
}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;min-height:100%;background:var(--bg);color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
.wrap{max-width:900px;margin:0 auto;padding:26px 16px 60px}
.brand{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.logo{height:40px;width:auto;display:block;border-radius:8px}
.logo-fb{font-size:1.7rem;line-height:1}
.brand-name{font-weight:700;font-size:1.05rem;letter-spacing:.04em;color:var(--accent2)}
h1{font-size:1.3rem;margin:0 0 4px}
.sub{color:var(--muted);font-size:0.85rem;margin:0 0 16px}
.total{display:inline-flex;align-items:center;gap:6px;background:var(--panel);border:1px solid var(--border);
  border-radius:20px;padding:6px 14px;font-size:0.82rem;color:var(--muted);margin-bottom:18px}
.total b{color:var(--accent2);font-size:1rem}
select{width:100%;padding:12px 14px;font-size:1rem;background:var(--panel);color:var(--text);
  border:1px solid var(--border);border-radius:10px;appearance:none;
  background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),linear-gradient(135deg,var(--muted) 50%,transparent 50%);
  background-position:calc(100% - 20px) calc(50% - 2px),calc(100% - 15px) calc(50% - 2px);
  background-size:5px 5px,5px 5px;background-repeat:no-repeat}
.controls{display:flex;gap:10px;flex-wrap:wrap}
.controls select{flex:1;min-width:180px}
input#search{flex:1;min-width:180px;padding:12px 14px;font-size:0.95rem;background:var(--panel);
  color:var(--text);border:1px solid var(--border);border-radius:10px}
input#search::placeholder{color:var(--muted)}
.count{margin:14px 0 0;color:var(--muted);font-size:0.85rem}
.count b{color:var(--accent2);font-size:1.05rem}
.grid{margin-top:14px;display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px}
.card{background:var(--panel);border:1px solid var(--border);border-radius:12px;overflow:hidden}
.photo{aspect-ratio:4/3;width:100%;background:var(--panel2);position:relative}
.photo img{width:100%;height:100%;object-fit:cover;display:block}
.photo .ph{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;
  font-size:0.7rem;color:rgba(255,255,255,.75);background:linear-gradient(135deg,var(--accent),var(--panel2))}
.photo .ph span:first-child{font-size:2rem}
.info{padding:10px 12px}
.name{font-weight:600;font-size:0.9rem;line-height:1.25}
.code{margin-top:6px;display:inline-block;background:var(--panel2);border:1px solid var(--border);border-radius:6px;
  padding:2px 8px;font-size:0.72rem;font-weight:600;color:var(--accent2);letter-spacing:.03em}
.empty{color:var(--muted);text-align:center;padding:50px 10px;font-size:0.9rem}
</style>
</head>
<body>
<div class="wrap">
  <div class="brand">
    <img src="logocarros.jpg" alt="jotwils" class="logo" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'logo-fb',textContent:'🏎️'}))">
    <span class="brand-name">jotwils</span>
  </div>
  <h1>Mi Colección</h1>
  <p class="sub">Elige una marca y verás todos tus carros de esa marca con su foto y código.</p>
  <div class="total"><b id="totalCount">0</b> carritos en total</div>

  <div class="controls">
    <select id="brandSelect"><option value="">— Selecciona una marca —</option></select>
    <input id="search" type="text" placeholder="Buscar marca o código...">
  </div>
  <div class="count" id="count"></div>
  <div class="grid" id="grid"></div>
  <div class="empty" id="empty">Selecciona una marca para ver tus carros.</div>
</div>

