const select = document.getElementById('brandSelect');
const grid = document.getElementById('grid');
const count = document.getElementById('count');
const empty = document.getElementById('empty');
document.getElementById('totalCount').textContent = data.length;

const brandCounts = {};
data.forEach(c => brandCounts[c.marca] = (brandCounts[c.marca]||0)+1);
Object.keys(brandCounts).sort().forEach(b=>{
  const o=document.createElement('option');
  o.value=b; o.textContent = b + " (" + brandCounts[b] + ")";
  select.appendChild(o);
});

const search = document.getElementById('search');

function render(){
  const b = select.value;
  const q = search.value.trim().toLowerCase();
  grid.innerHTML='';
  const hasFilter = b || q;
  if(!hasFilter){count.innerHTML='';empty.style.display='block';empty.textContent='Selecciona una marca o escribe para buscar.';return;}
  const cars = data.filter(c =>
    (!b || c.marca===b) &&
    (!q || c.marca.toLowerCase().includes(q) || c.codigo.toLowerCase().includes(q) || c.modelo.toLowerCase().includes(q))
  );
  empty.style.display = cars.length ? 'none' : 'block';
  empty.textContent = 'No hay resultados con ese filtro.';
  count.innerHTML = cars.length ? ("<b>" + cars.length + "</b> carritos encontrados") : "";
  cars.forEach(c=>{
    const card=document.createElement('div');
    card.className='card';
    card.innerHTML =
      '<div class="photo"><img src="CARROS/' + c.codigo + '.jpg" alt="' + c.modelo + '"></div>' +
      '<div class="info"><div class="name">' + c.modelo + '</div>' +
      '<div class="code">' + c.codigo + '</div></div>';
    const img=card.querySelector('img');
    img.onerror=()=>{
      img.remove();
      const ph=document.createElement('div');
      ph.className='ph';
      ph.innerHTML='<span>🏎️</span><span>Sin foto</span>';
      card.querySelector('.photo').appendChild(ph);
    };
    grid.appendChild(card);
  });
}
select.addEventListener('change',render);
search.addEventListener('input',render);
render();
